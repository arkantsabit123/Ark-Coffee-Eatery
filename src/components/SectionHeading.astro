---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}
const { eyebrow, title, description } = Astro.props;
---

<div class="max-w-2xl">
  <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-current opacity-70">
    {eyebrow}
  </p>
  <h2 class="display-heading text-3xl md:text-4xl text-current">
    {title}
  </h2>
  {description && (
    <p class="mt-4 text-lg leading-8 text-current opacity-80">
      {description}
    </p>
  )}
</div>