---
import SectionHeading from './SectionHeading.astro';

const steps = [
  { number: '01', title: 'Explore', description: 'Browse the menu and café gallery.' },
  { number: '02', title: 'Plan', description: 'Check the address and opening hours.' },
  { number: '03', title: 'Contact', description: 'Message us on WhatsApp for menu or reservation questions.' },
];
---

<section id="how-it-works" data-page-region="steps" class="section-space">
  <div class="page-shell">
    <SectionHeading
      eyebrow="A simple guide"
      title="Take it one step at a time"
      description="A clear path from browsing to planning a visit."
    />
    <ol class="grid gap-5 md:grid-cols-3">
      {steps.map((step) => (
        <li class="rounded-2xl border border-ark-brown/10 bg-white/60 p-6 md:p-8">
          <span class="grid size-12 place-items-center rounded-full bg-ark-brown text-sm font-semibold text-white">
            {step.number}
          </span>
          <h3 class="mt-5 text-xl font-semibold text-ark-brown">{step.title}</h3>
          <p class="mt-2 leading-7 text-stone-600">{step.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
