---
import { site } from '../data/site';
---

<header
  id="site-header"
  data-page-region="navbar"
  class="sticky top-0 z-40 border-b border-ark-brown/10 bg-ark-cream/90 backdrop-blur-lg"
>
  <div class="page-shell relative flex min-h-18 items-center justify-between gap-5">
    <a class="flex min-h-11 items-center gap-3 font-semibold text-ark-brown" href="#home">
      <img
        src={`${import.meta.env.BASE_URL}favicon.jpg`}
        alt="Ark Coffee"
        class="size-10 rounded-full object-cover border border-ark-brown/10"
        width="40"
        height="40"
      />
      <span>{site.name}</span>
    </a>
    <button
      class="nav-toggle inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg border border-ark-brown/20 text-ark-brown focus-visible:outline-offset-2 md:hidden"
      type="button"
      aria-controls="primary-navigation"
      aria-expanded="false"
      aria-label="Open navigation menu"
      data-nav-toggle
    >
      <span aria-hidden="true" class="text-xl leading-none">☰</span>
    </button>
    <nav
      id="primary-navigation"
      aria-label="Main navigation"
      class="nav-links absolute left-0 right-0 top-full flex-col items-stretch gap-1 md:static md:flex md:flex-row md:items-center md:gap-1"
      data-nav-links
    >
      <a class="rounded-full px-4 py-3 text-sm text-stone-700 hover:bg-ark-cream-dark" href="#menu">Menu</a>
      <a class="rounded-full px-4 py-3 text-sm text-stone-700 hover:bg-ark-cream-dark" href="#gallery">Gallery</a>
      <a class="rounded-full px-4 py-3 text-sm text-stone-700 hover:bg-ark-cream-dark" href="#location">Visit</a>
      <a class="rounded-full px-4 py-3 text-sm text-stone-700 hover:bg-ark-cream-dark" href="#faq">FAQ</a>
      <a
        class="inline-flex min-h-11 items-center justify-center rounded-full bg-ark-whatsapp px-5 py-3 text-sm font-semibold text-ark-ink transition-colors hover:brightness-95"
        href={`https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent('Hello Ark Coffee & Eatery, I would like to make a reservation request.')}`}
        target="_blank"
        rel="noopener noreferrer">WhatsApp</a
      >
    </nav>
  </div>
</header>

<script>
  import '../scripts/navigation';
</script>