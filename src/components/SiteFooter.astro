---
import { site } from '../data/site';
import { formatMenuPrice } from '../data/menu';
import { reservationPolicy } from '../data/reservation';
---

<footer id="site-footer" data-page-region="footer" class="border-t border-ark-brown/10 bg-ark-cream-dark/55 py-10">
  <div class="page-shell flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <a class="font-display text-2xl text-ark-brown" href="#home">{site.name}</a>
      <p class="mt-2 max-w-xl text-sm leading-6 text-stone-600">
        {site.address}
      </p>
      <div class="mt-3 flex flex-wrap gap-4 text-sm font-semibold text-ark-brown">
        <a href={`https://wa.me/${site.whatsappNumber}`} target="_blank" rel="noopener noreferrer">WhatsApp</a>
        <a href={site.instagramUrl} target="_blank" rel="noopener noreferrer">Instagram</a>
        <a href={`mailto:${site.ownerEmail}`}>Email</a>
        <a href={`${import.meta.env.BASE_URL}privacy/`}>Privacy</a>
      </div>
      <p class="mt-4 max-w-2xl text-xs leading-5 text-stone-500">
        Reservation policy: requests must be submitted no later than 1 day before arrival.
        Start times are {reservationPolicy.bookingStartTime}–{reservationPolicy.latestBookingStart}, with all bookings ending by {reservationPolicy.latestBookingEnd}.
        A pre-order of at least {formatMenuPrice(reservationPolicy.minimumOrderTotal)} per reservation and full payment are required; prices include tax.
        Customer cancellations and no-shows after 1 hour without contact forfeit payment. If the café cannot fulfill the reservation or order, payment is refunded in full.
        Reservation inquiries are retained for {site.reservationRetention}.
        Privacy contact: {site.privacyContact}.
      </p>
    </div>
    <p class="text-sm text-stone-500">&copy; {new Date().getFullYear()} {site.name}</p>
  </div>
</footer>
